# Copy to .env.local and fill in from your Supabase project (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Boss project reviews (/api/boss/review) use it now; without it, learners review their own work.
# Later also the AI coach (Tee) and content drafting.
ANTHROPIC_API_KEY=

# Server-only. Signs share links so cards (and later credentials) show "Verified by Shape". Any long random string;
# rotating it un-verifies old links. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SHARE_SIGNING_SECRET=
